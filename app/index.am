// app/index.am  →  GET /
//
// Pollen Manager — landing page hosting the workflow editor.
// Phase 4.1 ships drag-and-drop WYSIWYG on the SVG canvas, a
// click-to-select side panel for editing each node's
// host/port/consumes/emits/next, and Add/Delete buttons. Node
// positions persist in workflow.json under the `_layout` sidecar
// key (ignored by Pollen Phase 3.x runtime — purely cosmetic).

import Amalgame.Web

public class Page {
    public static HttpResponse GET(ctx: WebContext) {
        let html: string = "<!doctype html><html><head>" +
            "<meta charset=\"utf-8\">" +
            "<title>Pollen Manager</title>" +
            "<link rel=\"stylesheet\" href=\"/style.css\">" +
            "</head><body>" +
            "<header>" +
            "<img src=\"/images/pollen-mark.svg\" alt=\"Pollen\" class=\"logo\">" +
            "<h1>Pollen Manager</h1>" +
            "<p class=\"subtitle\">workflow.json · v0.1.0-dev</p>" +
            "<div class=\"mode-switch\" role=\"tablist\">" +
            "<button id=\"mode-edit\"  class=\"mode-btn active\" role=\"tab\" aria-selected=\"true\">Edit</button>" +
            "<button id=\"mode-watch\" class=\"mode-btn\"        role=\"tab\" aria-selected=\"false\">Watch</button>" +
            "</div>" +
            "<label class=\"debug-toggle\" title=\"Intercept debug pauses (DEBUG_PAUSE messages from Pollen nodes).&#10;Off = safe in prod, even when --debug publishers exist.\">" +
            "<input id=\"debug-toggle\" type=\"checkbox\">" +
            "<span class=\"debug-toggle-label\">⏸ Debug</span>" +
            "</label>" +
            "<div id=\"bp-summary\" class=\"bp-summary\" hidden>" +
            "<span class=\"bp-label\">BP:</span>" +
            "<span id=\"bp-list\" class=\"bp-list\"></span>" +
            "<button id=\"bp-copy\" class=\"bp-copy\" title=\"Copy --debug-bp arg\">⎘</button>" +
            "<button id=\"bp-clear\" class=\"bp-clear\" title=\"Clear all breakpoints\">✕</button>" +
            "</div>" +
            "</header>" +
            // ── Debug bridge banner (Phase 4.5.3) ──
            // Hidden by default, shown when /api/debug/pauses
            // returns a non-empty list. Polished in 4.5.5.
            "<div id=\"debug-bar\" hidden>" +
            "<div class=\"top\">" +
            "<span class=\"label\">⏸ Debug paused</span>" +
            "<span id=\"debug-bar-info\" class=\"info\"></span>" +
            "<div class=\"actions\">" +
            "<button id=\"dbg-mutate-toggle\" title=\"Edit msg.data and replay\">✎ Edit</button>" +
            "<button id=\"dbg-step-over\" class=\"primary\" title=\"F10\">⇣ Step Over</button>" +
            "<button id=\"dbg-step-into\" title=\"F11\">⇩ Step Into</button>" +
            "<button id=\"dbg-continue\" title=\"F5\">▶ Continue</button>" +
            "<button id=\"dbg-cancel\" class=\"danger\" title=\"Esc\">✕ Cancel</button>" +
            "</div>" +
            "</div>" +
            "<div id=\"dbg-mutate-panel\" hidden>" +
            "<label>Edit msg.data — operator sees the current value, types a new one, picks an apply mode :</label>" +
            "<textarea id=\"dbg-mutate-data\" spellcheck=\"false\" rows=\"4\"></textarea>" +
            "<div class=\"actions\">" +
            "<button id=\"dbg-mutate-apply-continue\" class=\"primary\">▶ Apply &amp; Continue</button>" +
            "<button id=\"dbg-mutate-apply-step\">⇩ Apply &amp; Step</button>" +
            "</div>" +
            "</div>" +
            "</div>" +
            "<main>" +
            "<section id=\"graph\">" +
            "<div class=\"section-head\">" +
            "<h2>DAG</h2>" +
            "<div class=\"toolbar\">" +
            "<button id=\"add-node\">+ Add node</button>" +
            "<button id=\"delete-node\" disabled>Delete selected</button>" +
            "<button id=\"dag-relayout\" title=\"Recompute node positions from current tree topology\">↻ Re-layout</button>" +
            "</div>" +
            "</div>" +
            "<svg id=\"dag\" viewBox=\"0 0 800 420\"></svg>" +
            "<p class=\"hint\">Drag nodes to reposition · Click to select · Layout persists in <code>_layout</code></p>" +
            // ── Workflow tree (Phase 5.x) ──
            // Renders the v2 `tree` field as a nested outline so the
            // operator can see if / elseif / else / set / for / while
            // alongside the DAG. The DAG view above stays focused on
            // topology ; this section is structure-only. Editing
            // controls land in Phase 5.5+.
            "<div class=\"section-head tree-head\">" +
            "<h2>Tree <span id=\"tree-schema-tag\" class=\"tag\"></span></h2>" +
            "<div class=\"toolbar\">" +
            "<button id=\"tree-add-if\" title=\"Append an if/elseif/else template at the end of the top-level sequence\">+ if</button>" +
            "<button id=\"tree-add-set\" title=\"Append a set state.X step\">+ set</button>" +
            "<button id=\"tree-add-for\" title=\"Append a for var in [items] step\">+ for</button>" +
            "<button id=\"tree-add-while\" title=\"Append a while cond + maxIter step\">+ while</button>" +
            "<span class=\"toolbar-sep\"></span>" +
            "<button id=\"tree-up\" disabled title=\"Move selected step up\">↑</button>" +
            "<button id=\"tree-down\" disabled title=\"Move selected step down\">↓</button>" +
            "<button id=\"tree-delete\" disabled title=\"Delete selected step\" class=\"danger\">✕</button>" +
            "<span class=\"toolbar-sep\"></span>" +
            "<button id=\"tree-validate\" title=\"Check refs + structure before Save\">✓ Validate</button>" +
            "<button id=\"tree-migrate\" hidden title=\"Convert v1 (flat next:[]) → v2 (tree)\">⇪ Migrate v1→v2</button>" +
            "</div>" +
            "</div>" +
            "<div id=\"tree-view\">" +
            "<p class=\"placeholder\" id=\"tree-empty\">No <code>tree</code> in this workflow. Add one in Raw JSON or upgrade to schema <code>workflow-tree/v1</code>.</p>" +
            "<ol id=\"tree-outline\" hidden></ol>" +
            "</div>" +
            "<details id=\"tree-step-edit\" hidden>" +
            "<summary>Edit selected step (<span id=\"tree-step-label\">none</span>)</summary>" +
            "<textarea id=\"tree-step-src\" spellcheck=\"false\" rows=\"8\"></textarea>" +
            "<div class=\"actions\">" +
            "<button id=\"tree-step-apply\">Apply step</button>" +
            "<span id=\"tree-step-status\" class=\"hint\"></span>" +
            "</div>" +
            "</details>" +
            "<div class=\"section-head live-head\">" +
            "<h2>Live executions</h2>" +
            "<div class=\"toolbar\">" +
            "<span id=\"live-meta\"></span>" +
            "<button id=\"cleanup\" title=\"Purge records older than EXEC_RETENTION_MIN (default 60min)\">Cleanup</button>" +
            "</div>" +
            "</div>" +
            "<ol id=\"live-list\"><li class=\"placeholder\">Switch to <strong>Watch</strong> mode to see live executions.</li></ol>" +
            "</section>" +
            "<aside id=\"inspector\">" +
            "<div class=\"section-head\">" +
            "<h2>Inspector</h2>" +
            "</div>" +
            "<div id=\"inspector-empty\" class=\"placeholder\">Click a node to edit.</div>" +
            "<form id=\"inspector-form\" hidden>" +
            "<label>Name <input id=\"f-name\" type=\"text\"></label>" +
            "<label>Host <input id=\"f-host\" type=\"text\" placeholder=\"127.0.0.1\"></label>" +
            "<label>Port <input id=\"f-port\" type=\"number\"></label>" +
            "<label>Consumes <div id=\"f-consumes\" class=\"chips chips-input\" data-placeholder=\"topic + Enter\"></div></label>" +
            "<label>Emits <div id=\"f-emits\" class=\"chips chips-input\" data-placeholder=\"topic + Enter\"></div></label>" +
            "<label id=\"f-next-row\">Next <div id=\"f-next\" class=\"chips chips-input\" data-placeholder=\"node + Enter\"></div></label>" +
            "<button type=\"button\" id=\"apply\">Apply</button>" +
            "</form>" +
            "<details id=\"raw-view\">" +
            "<summary>Raw JSON (edit + Apply to update tree)</summary>" +
            "<textarea id=\"src\" spellcheck=\"false\"></textarea>" +
            "<div class=\"actions\">" +
            "<button id=\"apply-raw\">Apply JSON</button>" +
            "<span id=\"raw-status\" class=\"hint\"></span>" +
            "</div>" +
            "</details>" +
            // ── Inject debug message (Phase 4.5.5) ──
            // Visible only when ⏸ Debug is on. Manager builds the
            // envelope + sends it via TCP to the target node, no
            // CLI required. Auto-mode : breakpoints set → mode=
            // breakpoint, none set → mode=step.
            "<section id=\"inject-panel\" hidden>" +
            "<div class=\"section-head\"><h2>Inject debug msg</h2></div>" +
            "<form id=\"inject-form\">" +
            "<label>Target node <select id=\"inject-target\"></select></label>" +
            "<label>Topic <select id=\"inject-topic\"></select></label>" +
            "<label>Data (JSON) <textarea id=\"inject-data\" rows=\"3\" spellcheck=\"false\">{\"hello\":\"world\"}</textarea></label>" +
            "<div class=\"hint\" id=\"inject-mode-hint\"></div>" +
            "<button type=\"button\" id=\"inject-send\" class=\"primary\">▶ Send</button>" +
            "</form>" +
            "</section>" +
            "<div class=\"actions\">" +
            "<button id=\"save\">Save</button>" +
            "<button id=\"reload\">Reload</button>" +
            "<span id=\"status\"></span>" +
            "</div>" +
            "</aside>" +
            "</main>" +
            "<script src=\"/manager.js\"></script>" +
            "</body></html>"
        return HttpResponse.New().Html(html)
    }
}
