// app/api/workflow.am  →  GET /api/workflow
//
// Returns the workflow.json file referenced by WORKFLOW_PATH
// (defaults to /tmp/pollen-wf.json) verbatim.
//
// PUT is deferred to Phase 4.0.5: amalgame-web v0.13.3 WebContext
// only exposes Params/State/Session/RequestId — there is no
// request-body accessor on the handler input. Once a future
// amalgame-web revision adds `ctx.Body: string` (or equivalent),
// flip the editor into read-write here. Until then the user
// edits the file on disk and Pollen's Phase 3.3 watcher picks
// the change up within ~2 s.

import Amalgame.Web

public class Page {
    public static HttpResponse GET(ctx: WebContext) {
        var path: string = Env_Get("WORKFLOW_PATH")
        if (String_Length(path) == 0) { path = "/tmp/pollen-wf.json" }
        if (!File_Exists(path)) {
            return HttpResponse.New()
                .Status(404)
                .Header("content-type", "application/json")
                .Text("{\"error\":\"workflow file not found at " + path + "\"}")
        }
        let body: string = File_ReadAll(path)
        return HttpResponse.New()
            .Header("content-type", "application/json")
            .Text(body)
    }
}
