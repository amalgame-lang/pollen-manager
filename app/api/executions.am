// app/api/executions.am  →  GET /api/executions
//
// Lists every <mid>-<role>.json record written by Pollen nodes
// under <SHARED_DIR>/executions/ (Phase 3.5 sharedDir feature).
//
// Returns a JSON array, newest-first, each element:
//   { "file":        "<mid>-<role>.json",
//     "messageId":   "<uuid>",
//     "role":        "<role>",
//     "record":      <full JSON object from the file> }
//
// `ls -1t` gives mtime-newest-first ordering, capped at 100
// entries (more than enough for a live dashboard).
//
// Note: the implementation uses `Process.RunCapture("ls -1t …")`
// instead of an opendir/readdir @c{} block. Two reasons:
//   1. amc's stdlib has File_IsDir / File_ReadAll but no portable
//      Directory_ListFiles primitive yet.
//   2. ls is cheap (<1ms for a few hundred entries) and the
//      Process call lets us order by mtime "for free", which
//      we'd otherwise have to re-implement via File_Mtime calls
//      after readdir.

import Amalgame.Web

public class Page {
    public static HttpResponse GET(ctx: WebContext) {
        var shared: string = Env_Get("SHARED_DIR")
        if (String_Length(shared) == 0) { shared = "/tmp/pollen-shared" }
        let execDir: string = shared + "/executions"

        if (!File_Exists(execDir)) {
            return HttpResponse.New()
                .Header("content-type", "application/json")
                .Text("[]")
        }

        // ls -1t: one filename per line, newest mtime first.
        // Type annotation omitted to dodge an amc cgen quirk:
        // the routes generator renames our class to
        // Api_Executions_Page (App namespace), and an explicit
        // `: ProcessResult` then gets re-mangled to
        // `App_ProcessResult` instead of `AmalgameProcessResult`.
        let listing = Process.RunCapture("ls -1t '" + execDir + "' 2>/dev/null")
        let stdout: string = listing.Stdout
        let lines: List<string> = String_Split(stdout, "\n")

        var out: string = "["
        var first: bool = true
        var emitted: int = 0
        let cap: int = 100

        let n: int = lines.Count()
        for i in 0..n {
            if (emitted >= cap) { break }
            let name: string = lines.Get(i)
            if (String_Length(name) == 0) { continue }
            if (!String_EndsWith(name, ".json")) { continue }

            // Filename is <mid>-<role>.json. Drop the .json suffix
            // then split on the LAST '-' so the UUID's own dashes
            // are preserved.
            let baseLen: int = String_Length(name) - 5
            let bare: string = String_Substring(name, 0, baseLen)
            let dashIdx: int = String_LastIndexOf(bare, "-")
            var mid:  string = bare
            var role: string = ""
            if (dashIdx > 0) {
                mid  = String_Substring(bare, 0, dashIdx)
                role = String_Substring(bare, dashIdx + 1, String_Length(bare) - dashIdx - 1)
            }

            let path: string = execDir + "/" + name
            let body: string = File_ReadAll(path)
            // body already ends with '\n' (Pollen writes it that
            // way); trim to keep the inline JSON valid.
            var trimmed: string = body
            let blen: int = String_Length(trimmed)
            if (blen > 0 && String_CharAt1(trimmed, blen - 1) == "\n") {
                trimmed = String_Substring(trimmed, 0, blen - 1)
            }

            if (first) {
                out = out + "{"
                first = false
            } else {
                out = out + ",{"
            }
            out = out +
                "\"file\":\"" + name + "\"," +
                "\"messageId\":\"" + mid + "\"," +
                "\"role\":\"" + role + "\"," +
                "\"record\":" + trimmed + "}"
            emitted = emitted + 1
        }
        out = out + "]"

        return HttpResponse.New()
            .Header("content-type", "application/json")
            .Text(out)
    }
}
