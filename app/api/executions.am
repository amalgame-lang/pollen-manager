// app/api/executions.am  →  GET /api/executions[?since=<ts>]
//
// Lists <SHARED_DIR>/executions/<mid>-<role>.json records, newest
// mtime first. With `?since=<ms-epoch>`, only records whose JSON
// `timestamp` field is strictly greater than `since` are returned.
//
// Output JSON :
//   [ { "file":"<mid>-<role>.json",
//       "messageId":"<uuid>",
//       "role":"<role>",
//       "record": <full record JSON> },
//     ... ]
//
// Implementation notes:
//   - List<string>.Join("") at the end instead of `out = out + …`
//     in a hot loop, which is O(N²) in AM (each `+` reallocates
//     the whole running string). Brings 1000-record fetch from
//     ~500ms back down to ~5ms.
//   - We stop early when `ls -1t` (newest-first) returns a file
//     whose timestamp ≤ since — everything below it in the listing
//     is by definition older.
//   - 100-entry cap kept as a safety net.

import Amalgame.Web
import Amalgame.Collections

public class Page {
    public static HttpResponse GET(ctx: WebContext) {
        var shared: string = Env_Get("SHARED_DIR")
        if (String_Length(shared) == 0) { shared = "/tmp/pollen-shared" }
        let execDir: string = shared + "/executions"

        if (!File_Exists(execDir)) {
            return HttpResponse.New()
                .Header("content-type", "application/json")
                .Text("[]")
        }

        // Parse ?since=<ts>. Absent or "0" → return everything.
        var sinceRaw: string = ""
        if (ctx.Query != null && ctx.Query.Has("since")) {
            sinceRaw = ctx.Query.Get("since")
        }
        var sinceTs: int = 0
        if (String_Length(sinceRaw) > 0) {
            sinceTs = String_ToInt(sinceRaw)
        }

        let listing = Process.RunCapture("ls -1t '" + execDir + "' 2>/dev/null")
        let stdout: string = listing.Stdout
        let lines: List<string> = String_Split(stdout, "\n")

        let parts: List<string> = new List<string>()
        var emitted: int = 0
        let cap: int = 100

        let n: int = lines.Count()
        for i in 0..n {
            if (emitted >= cap) { break }
            let name: string = lines.Get(i)
            if (String_Length(name) == 0) { continue }
            if (!String_EndsWith(name, ".json")) { continue }

            let baseLen: int = String_Length(name) - 5
            let bare: string = String_Substring(name, 0, baseLen)
            let dashIdx: int = String_LastIndexOf(bare, "-")
            var mid:  string = bare
            var role: string = ""
            if (dashIdx > 0) {
                mid  = String_Substring(bare, 0, dashIdx)
                role = String_Substring(bare, dashIdx + 1, String_Length(bare) - dashIdx - 1)
            }

            let path: string = execDir + "/" + name
            let body: string = File_ReadAll(path)
            // Trim trailing newline.
            var trimmed: string = body
            let blen: int = String_Length(trimmed)
            if (blen > 0 && String_CharAt1(trimmed, blen - 1) == "\n") {
                trimmed = String_Substring(trimmed, 0, blen - 1)
            }

            // Timestamp extract — substring between `"timestamp":`
            // and the next `}`. Trusts the Pollen writer's exact
            // format (the field is last → terminator is `}`).
            // We don't drag in the full JsonParser for one int.
            var recordTs: int = 0
            if (sinceTs > 0) {
                let marker: string = "\"timestamp\":"
                let mi: int = String_IndexOf(trimmed, marker)
                if (mi >= 0) {
                    let start: int = mi + String_Length(marker)
                    let rest: string = String_Substring(trimmed, start,
                                                         String_Length(trimmed) - start)
                    let endIdx: int = String_IndexOf(rest, "}")
                    if (endIdx > 0) {
                        let numStr: string = String_Substring(rest, 0, endIdx)
                        recordTs = String_ToInt(numStr)
                    }
                }
                if (recordTs <= sinceTs) {
                    // ls -1t orders by mtime, not record.timestamp.
                    // Two records of the same chain can land out of
                    // order, so we keep scanning instead of breaking.
                    continue
                }
            }

            parts.Add("{\"file\":\"")
            parts.Add(name)
            parts.Add("\",\"messageId\":\"")
            parts.Add(mid)
            parts.Add("\",\"role\":\"")
            parts.Add(role)
            parts.Add("\",\"record\":")
            parts.Add(trimmed)
            parts.Add("}")
            if (emitted + 1 < cap) {
                parts.Add(",")
            }
            emitted = emitted + 1
        }

        // Strip trailing "," if we appended one and didn't follow
        // up (because the loop ran out before the next iteration).
        let plen: int = parts.Count()
        if (plen > 0 && parts.Get(plen - 1) == ",") {
            parts.RemoveAt(plen - 1)
        }

        // Single allocation : "[" + join + "]"
        var inner: string = ""
        let pn: int = parts.Count()
        if (pn > 0) {
            inner = String_Join(parts, "")
        }
        let out: string = "[" + inner + "]"

        return HttpResponse.New()
            .Header("content-type", "application/json")
            .Text(out)
    }

}
