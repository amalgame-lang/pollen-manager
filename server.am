// pollen-manager — Mosaic entry point.

namespace App

import Amalgame.Collections
import Amalgame.Web
import Amalgame.Net.Http
import Amalgame.Threading
import Amalgame.DateTime

public class Program {
    public static int Main(string[] args) {
        let app: WebApp = WebApp.New()
        Routes.Bind(app)

        Console.WriteLine("pollen-manager — listening on http://localhost:3000")
        // Single-hop binding to dodge an amc cgen quirk that mangles
        // chained access through two identically-named fields
        // (WebApp.Routes:Router and Router.Routes:List<Route>).
        let router: Router = app.Routes
        Console.WriteLine("  routes:  " + String_FromInt(router.Routes.Count()))
        Console.WriteLine("  static:  " + String_FromInt(app.StaticMounts.Count()) + " mount(s)")

        // ── Background GC of executions/ ──
        // Periodically purges <SHARED_DIR>/executions/<mid>-<role>.json
        // records older than EXEC_RETENTION_MIN minutes (default 60).
        // Without this the dir grows unbounded (1k msg/s × 4 hops →
        // 14M files/h). Configurable retention so audit-heavy setups
        // can crank it up, dev setups can keep it tight.
        var retentionMin: int = 60
        let retentionEnv: string = Env_Get("EXEC_RETENTION_MIN")
        if (String_Length(retentionEnv) > 0) {
            retentionMin = String_ToInt(retentionEnv)
            if (retentionMin <= 0) { retentionMin = 60 }
        }
        Console.WriteLine("  GC:      executions/ retention = " + String_FromInt(retentionMin) + " min")
        Console.WriteLine("")

        let gcRet: int = retentionMin
        let gcLoop = (arg: int) => {
            while (true) {
                // Sleep first so we don't blow at startup before
                // Pollen nodes had a chance to write anything.
                Threading.ThreadSleep(60000)
                Program.RunGc(gcRet)
            }
        }
        Threading.ThreadSpawn(gcLoop, 0)

        return app.Serve(3000)
    }

    // Scan <SHARED_DIR>/executions/, parse each record's timestamp,
    // unlink files where now - timestamp > retentionMin minutes.
    // Returns the number of files purged. Safe to call from both
    // the background loop and an /api/executions/cleanup endpoint.
    public static int RunGc(int retentionMin) {
        var shared: string = Env_Get("SHARED_DIR")
        if (String_Length(shared) == 0) { shared = "/tmp/pollen-shared" }
        let execDir: string = shared + "/executions"
        if (!File_Exists(execDir)) { return 0 }

        let nowNs: int = DateTime.NowNanos()
        let nowMs: int = nowNs / 1000000
        let cutoff: int = nowMs - (retentionMin * 60 * 1000)

        let listing = Process.RunCapture("ls -1 '" + execDir + "' 2>/dev/null")
        let lines: List<string> = String_Split(listing.Stdout, "\n")
        var purged: int = 0
        let n: int = lines.Count()
        for i in 0..n {
            let name: string = lines.Get(i)
            if (String_Length(name) == 0) { continue }
            if (!String_EndsWith(name, ".json")) { continue }
            let path: string = execDir + "/" + name
            let body: string = File_ReadAll(path)
            // Inline timestamp extract — same shape as the api/executions
            // handler. The Pollen writer puts timestamp as the last
            // field, so the `}` terminator is reliable.
            let marker: string = "\"timestamp\":"
            let mi: int = String_IndexOf(body, marker)
            if (mi < 0) { continue }
            let start: int = mi + String_Length(marker)
            let rest: string = String_Substring(body, start,
                                                 String_Length(body) - start)
            let endIdx: int = String_IndexOf(rest, "}")
            if (endIdx <= 0) { continue }
            let numStr: string = String_Substring(rest, 0, endIdx)
            let ts: int = String_ToInt(numStr)
            if (ts > 0 && ts < cutoff) {
                File_Delete(path)
                purged = purged + 1
            }
        }
        if (purged > 0) {
            Console.WriteLine("gc: purged " + String_FromInt(purged) + " record(s) older than "
                + String_FromInt(retentionMin) + " min")
            Console.Flush()
        }
        return purged
    }
}
