{
  "schema": "workflow-tree/v1",
  "name": "demo-pollen-full",
  "version": 1,
  "nodes": {
    "ingest":   { "host": "127.0.0.1", "port": 8000, "consumes": ["order.in"],       "emits": ["order.enriched"] },
    "enrich":   { "host": "127.0.0.1", "port": 8001, "consumes": ["order.enriched"], "emits": ["order.routed"] },
    "vip":      { "host": "127.0.0.1", "port": 8002, "consumes": ["order.routed"],   "group": "premium" },
    "standard": { "host": "127.0.0.1", "port": 8003, "consumes": ["order.routed"],   "group": "standard" }
  },
  "tree": {
    "type": "sequence",
    "steps": [
      { "type": "call", "node": "ingest" },
      { "type": "call", "node": "enrich" },
      { "type": "fan_out", "nodes": ["vip", "standard"] }
    ]
  },
  "_layout": {
    "ingest":   { "x": 140, "y": 130 },
    "enrich":   { "x": 140, "y": 290 },
    "vip":      { "x": 420, "y": 190 },
    "standard": { "x": 420, "y": 410 }
  }
}
